# ============================================================
# AUTO-V .gitignore – NEVER COMMIT SECRETS
# Production Ready - Complete Ignore Rules
# ============================================================

# ─── Environment Variables ──────────────────────────────────
.env
.env.*
*.env
.env.production
.env.local
.env.staging
.env.test
.env.dev
.env.development
.env.example
!.env.example
!.env.template

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
pythonenv*
.venv/
.virtualenv/
.ropeproject/
*.egg-info/
dist/
build/
*.egg
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# ─── IDE ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.iml
*.code-workspace
.sublime-project
.sublime-workspace
.ropeproject/
.ipynb_checkpoints/
*.ipynb

# ─── Logs ────────────────────────────────────────────────────
*.log
auto-v.log
*.log.*
logs/
*.out
access.log
error.log
gunicorn.log
app.log
*.pid
*.pid.lock
celerybeat-schedule
celerybeat.pid

# ─── Database ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.dump
*.sql
alembic_version
migrations/alembic_version

# ─── Testing ────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
*.cover
.pytest_cache/
test-results/
tests/__pycache__/
coverage.xml
*.prof
*.pstats
*.lcov

# ─── Secrets ────────────────────────────────────────────────
*.pem
*.key
*.crt
*.secret
*.env.encrypted
*.p12
*.pfx
*.cer
*.csr
*.der
secrets/
secret.key
private.key
*.token
*.jwt
*.jwk
*.id_rsa
*.id_dsa
*.ppk
*.gpg
*.asc

# ─── Render ──────────────────────────────────────────────────
# Remove these if you want to commit deployment configs
# render.yaml
# docker-compose.yml
# Dockerfile

# ─── Docker ──────────────────────────────────────────────────
docker-compose.override.yml
.dockerignore
*.pid.lock
*.pid

# ─── Frontend ──────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml
dist/
build/
.next/
out/
*.min.js
*.min.css
*.map
*.js.map
*.css.map

# ─── Uploads ────────────────────────────────────────────────
uploads/*
!uploads/.gitkeep
uploads/temp/*
uploads/images/*
uploads/documents/*
uploads/reports/*
uploads/certificates/*

# ─── Reports ────────────────────────────────────────────────
reports/*
!reports/.gitkeep
*.pdf
*.html
*.xlsx
*.csv
*.docx
*.pptx

# ─── Misc ──────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.old
*.orig
*~
\#*#
.\#*
*.cache
*.cached
.cache/
.cached/
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ─── Backup Files ──────────────────────────────────────────
*.backup
*.bak
*.old
*.orig
*.tmp
*.temp
*.swp
*.swo
*.~

# ─── System Files ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

