# ============================================================
# AUTO-V .gitignore – NEVER COMMIT SECRETS
# ============================================================

# ─── Environment Variables ──────────────────────────────────
.env
.env.*
*.env
.env.production
.env.local
.env.staging
.env.test

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
dist/
build/
*.egg

# ─── IDE ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.iml

# ─── Logs ────────────────────────────────────────────────────
*.log
auto-v.log
*.log.*
logs/

# ─── Database ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal

# ─── Testing ────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
*.cover
.pytest_cache/

# ─── Secrets ────────────────────────────────────────────────
*.pem
*.key
*.crt
*.secret
*.env.encrypted
*.p12
*.pfx

# ─── Render ──────────────────────────────────────────────────
render.yaml
docker-compose.yml
Dockerfile

# ─── Frontend ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/
.next/
out/

# ─── Misc ──────────────────────────────────────────────────
*.tmp
*.temp
.venv
.coverage
coverage.xml
.terraform/
*.terraform.lock.hcl
