# ============================================================
# AUTO-V BACKEND .gitignore
# Production Ready - Complete Ignore Rules
# ============================================================

# ─── Python ──────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyz
*.pyzw
*.so
*.egg
*.egg-info/
*.egg-info/
dist/
build/
.eggs/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# ─── Virtual Environments ──────────────────────────────────────
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
pythonenv*
.venv/
.virtualenv/
.ropeproject/

# ─── Environment Variables ────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.dev
*.env
!.env.example
!.env.template

# ─── Secrets & Keys ────────────────────────────────────────────
*.pem
*.key
*.crt
*.p12
*.pfx
*.p8
*.der
secrets/
secret.key
private.key
*.secret
*.token
*.jwt
*.jwk
*.id_rsa
*.id_dsa
*.ppk
*.gpg
*.asc

# ─── Uploads ────────────────────────────────────────────────────
uploads/*
!uploads/.gitkeep
uploads/temp/*
uploads/images/*
uploads/documents/*
uploads/reports/*
uploads/certificates/*
uploads/photos/*

# ─── Logs ──────────────────────────────────────────────────────
logs/*
*.log
*.log.*
access.log
error.log
gunicorn.log
app.log
*.out
*.pid
*.pid.lock
celerybeat-schedule
celerybeat.pid

# ─── Database ──────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.dump
*.sql
migrations/alembic_version
alembic.ini

# ─── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.~lock.*
*.iml
*.code-workspace
.sublime-project
.sublime-workspace
.ropeproject/
.ipynb_checkpoints/
*.ipynb

# ─── OS ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak
*.old
*.orig
*.lnk

