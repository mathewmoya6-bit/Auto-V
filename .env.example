# Copy to .env for local dev. On Render, set these in the dashboard's
# Environment tab instead — this file is not read in production unless
# you explicitly load it.

ENVIRONMENT=production
DEBUG=false

# ─── Supabase — Settings > API in your Supabase project ─────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service-role key: bypasses RLS, used for all backend writes.
# CONFIRM THE REAL VAR NAME — this was never set anywhere in the old
# codebase, meaning writes may have had no way to bypass RLS before.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-real-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS — comma-separated list read as JSON array by pydantic-settings ──
CORS_ORIGINS=["https://your-frontend.com"]

# ─── M-Pesa (optional — only needed if payments are enabled) ─────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=

# ─── Redis (optional — only needed for rate limiting) ─────────────────
REDIS_URL=redis://localhost:6379/0
