# ============================================
# AUTO-V Environment Variables
# ============================================

# Supabase Configuration
SUPABASE_URL=https://tsvejnzxrxrrecgquxbq.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# M-Pesa (Production)
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_passkey
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://auto-v-api.onrender.com/api/webhooks/mpesa-callback

# M-Pesa (Sandbox - Testing)
MPESA_SANDBOX_CONSUMER_KEY=sandbox_key
MPESA_SANDBOX_CONSUMER_SECRET=sandbox_secret
MPESA_SANDBOX_PASSKEY=sandbox_passkey

# AI Services
AI_API_KEY=your_ai_api_key
AI_VALUATION_ENDPOINT=https://api.ai-service.com/valuation
AI_DAMAGE_ENDPOINT=https://api.ai-service.com/damage

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=support@autov.co.ke

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# CORS
CORS_ORIGINS=http://localhost:3000,https://auto-v-frontend.onrender.com

# Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
